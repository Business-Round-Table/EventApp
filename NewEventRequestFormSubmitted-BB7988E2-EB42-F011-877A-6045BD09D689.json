        "Send_an_email_from_a_shared_mailbox_(V2)": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "emailMessage/MailboxAddress": "events@brt.org",
              "emailMessage/To": "eventmanagement@brt.org;HMelo@brt.org",
              "emailMessage/Subject": "New Event Request Form Submitted",
              "emailMessage/Body": "<p class=\"editor-paragraph\">New Event Request Form Submitted</p><br><p class=\"editor-paragraph\"><b><strong class=\"editor-text-bold\" style=\"font-size: 14px;\">Title:</strong></b></p><p class=\"editor-paragraph\">@{outputs('Get_item')?['body/Title']}</p><p class=\"editor-paragraph\"><br><b><strong class=\"editor-text-bold\" style=\"font-size: 14px;\">Who is Hosting this Event?:</strong></b></p><p class=\"editor-paragraph\">@{outputs('Get_item')?['body/Who_x0020_is_x0020_Hosting_x0020/Value']}</p><p class=\"editor-paragraph\"><br><b><strong class=\"editor-text-bold\" style=\"font-size: 14px;\">Start Date and Time:</strong></b></p><p class=\"editor-paragraph\">@{subtractFromTime(convertTimeZone(outputs('Get_item')?['body/Date'],'Eastern Standard Time','Eastern Standard Time'),3,'Hour','f')}</p><p class=\"editor-paragraph\"><br><b><strong class=\"editor-text-bold\" style=\"font-size: 14px;\">End Date and Time:</strong></b></p><p class=\"editor-paragraph\">@{subtractFromTime(convertTimeZone(outputs('Get_item')?['body/EndDateandTime'],'Eastern Standard Time','Eastern Standard Time'),3,'Hour','f')}</p><p class=\"editor-paragraph\"><br><b><strong class=\"editor-text-bold\" style=\"font-size: 14px;\">Host Organization:</strong></b><br>@{outputs('Get_item')?['body/Host_x0020_Organization']}</p><p class=\"editor-paragraph\"><br><b><strong class=\"editor-text-bold\" style=\"font-size: 14px;\">Event Type:</strong></b></p><p class=\"editor-paragraph\">@{triggerBody()?['EventType/Value']}</p><p class=\"editor-paragraph\"><br><b><strong class=\"editor-text-bold\" style=\"font-size: 14px;\">Off-Site Address:</strong></b></p><p class=\"editor-paragraph\">@{triggerBody()?['Off_x002d_Site_x0020_Address']}</p><p class=\"editor-paragraph\"><br><b><strong class=\"editor-text-bold\" style=\"font-size: 14px;\">Virtual/Hybrid Meeting Platform:</strong></b></p><p class=\"editor-paragraph\">@{triggerBody()?['Virtual_x002f_Hybrid_x0020_Meeti/Value']}</p><p class=\"editor-paragraph\"><br><b><strong class=\"editor-text-bold\" style=\"font-size: 14px;\">BRT Point of Contact for Meeting/Event:</strong></b></p><p class=\"editor-paragraph\">@{outputs('Get_item')?['body/BRTEventLead/DisplayName']}</p><p class=\"editor-paragraph\"><br><b><strong class=\"editor-text-bold\" style=\"font-size: 14px;\">Room or Location Name:</strong></b></p><p class=\"editor-paragraph\">@{triggerBody()?['RoomorLocationName/Value']}</p><br><p class=\"editor-paragraph\"><b><strong class=\"editor-text-bold\">8th Floor Mobile Registration Desk Needed?:</strong></b></p><p class=\"editor-paragraph\">@{triggerBody()?['OData__x0038_th_x0020_Floor_x0020_Mobi/Value']}</p><p class=\"editor-paragraph\"><br><b><strong class=\"editor-text-bold\" style=\"font-size: 14px;\">Meeting/Event Agenda:</strong></b></p><p class=\"editor-paragraph\">@{triggerBody()?['EventDescription']}</p><p class=\"editor-paragraph\"><br><b><strong class=\"editor-text-bold\" style=\"font-size: 14px;\">Estimated In-person Attendees:</strong></b></p><p class=\"editor-paragraph\">@{triggerBody()?['Estimated_x0020_In_x002d_person_']}</p><p class=\"editor-paragraph\"><br><b><strong class=\"editor-text-bold\" style=\"font-size: 14px;\">Estimated Virtual/Remote Attendees:</strong></b></p><p class=\"editor-paragraph\">@{triggerBody()?['Estimated_x0020_Virtual_x002f_Re']}</p><p class=\"editor-paragraph\"><br><b><strong class=\"editor-text-bold\" style=\"font-size: 14px;\">Will Member Company CEOs be attending?:</strong></b></p><p class=\"editor-paragraph\">@{triggerBody()?['Will_x0020_Member_x0020_Company_/Value']}</p><p class=\"editor-paragraph\"><br><b><strong class=\"editor-text-bold\" style=\"font-size: 14px;\">Room Setup Request:</strong></b></p><p class=\"editor-paragraph\">@{triggerBody()?['FacilityNeeds']}</p><p class=\"editor-paragraph\"><br><b><strong class=\"editor-text-bold\" style=\"font-size: 14px;\">AV/Technical needs:</strong></b></p><p class=\"editor-paragraph\">@{triggerBo